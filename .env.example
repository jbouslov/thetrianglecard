# -----------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in your real values.
# `.env.local` is git-ignored and must NEVER be committed.
# On Vercel, add these same variables under Settings → Environment Variables.
# -----------------------------------------------------------------------------

# Your Stripe SECRET key. Get it at https://dashboard.stripe.com/apikeys
# Use the TEST key (sk_test_...) while testing, and the LIVE key (sk_live_...)
# when you're ready to accept real payments.
STRIPE_SECRET_KEY=sk_test_your_key_here

# Optional: your production URL, used for Stripe redirect links as a fallback.
NEXT_PUBLIC_SITE_URL=https://thetrianglecard.com
